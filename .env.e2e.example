# Playwright E2E targets the LOCAL Supabase stack only. Never point these at
# the hosted project — the suite creates users, messages, and servers.
#
#   npx supabase start
#   npx supabase status -o env   # copy the values it prints
#   cp .env.e2e.example .env.e2e

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<ANON_KEY from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from `supabase status`>
