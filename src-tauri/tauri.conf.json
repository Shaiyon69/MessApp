{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "messapp",
  "version": "0.1.8",
  "identifier": "com.shaiyon.messapp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MessApp",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "base-uri": "'self'",
        "object-src": "'none'",
        "connect-src": "ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://api.microlink.io https://api.giphy.com https://*.giphy.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' asset: http://asset.localhost data: blob: https:",
        "media-src": "'self' asset: http://asset.localhost data: blob: https:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "frame-src": "https://www.youtube-nocookie.com",
        "worker-src": "'self' blob:"
      },
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Permissions-Policy": "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=()"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
