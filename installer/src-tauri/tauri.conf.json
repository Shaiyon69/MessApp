{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Messapp Setup",
  "version": "1.0.0",
  "identifier": "com.shaiyon.messapp.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Messapp Setup",
        "width": 460,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
